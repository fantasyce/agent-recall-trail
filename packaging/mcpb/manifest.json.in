{
  "manifest_version":"0.3",
  "name":"agent-recall-trail",
  "display_name":"Agent Recall Trail",
  "version":"@VERSION@",
  "description":"Private Agent memory and governed shared knowledge.",
  "long_description":"ART gives every Agent a physically separate private Recall Trail and exposes immutable Knowledge Editions governed through a local human page or an explicit, default-off Agent delegation policy.",
  "author":{"name":"Agent Recall Trail contributors","url":"https://github.com/fantasyce/agent-recall-trail"},
  "repository":{"type":"git","url":"https://github.com/fantasyce/agent-recall-trail.git"},
  "documentation":"https://github.com/fantasyce/agent-recall-trail/blob/main/docs/operations.md",
  "support":"https://github.com/fantasyce/agent-recall-trail/issues",
  "server":{"type":"binary","entry_point":"server/art-linux-amd64","mcp_config":{"command":"server/art-linux-amd64","args":["mcp","serve","--agent","codex-primary"],"env":{},"platform_overrides":{"darwin":{"command":"server/art-darwin-arm64","args":["mcp","serve","--agent","codex-primary"]}}}},
  "tools":[
    {"name":"art_recall","description":"Recall private Agent memory and reviewed shared knowledge."},
    {"name":"art_read","description":"Read one authorized memory or Knowledge Edition."},
    {"name":"art_memory_capture","description":"Submit a bounded sourced private memory. Proactive capture uses agent_initiated and value_reason with automatic memory enabled; explicit user_requested capture requires sanitized request_basis and works while automatic memory is off."},
    {"name":"art_memory_candidate_submit","description":"Submit at most one private-memory candidate from an exact ART Stop Hook trigger receipt. Shares the ordinary Agent value standard, switch and budget; never use without the genuine trigger receipt."},
    {"name":"art_knowledge_propose","description":"Draft a knowledge proposal for later human review."},
    {"name":"art_knowledge_governance","description":"Request human governance or an enabled atomic delegated approval and publication."},
    {"name":"art_governance_ui_open","description":"Open the bound local governance page for settings, review, publication, and audit."},
    {"name":"art_feedback","description":"Record bounded feedback on recalled evidence."},
    {"name":"art_health","description":"Inspect the bound Agent runtime health."}
  ],
  "keywords":["agent memory","knowledge base","mcp","codex","dsh"],
  "license":"Apache-2.0",
  "compatibility":{"platforms":["darwin","linux"]},
  "_meta":{"io.github.fantasyce.agent-recall-trail":{"build":{"commit":"@COMMIT@"}}}
}
